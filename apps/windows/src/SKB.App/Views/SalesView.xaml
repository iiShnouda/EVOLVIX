<UserControl x:Class="SKB.App.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{Binding [sales.invoices], Source={StaticResource Loc}}"
               Style="{StaticResource H1}" Margin="0,0,0,14" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="380" />
      </Grid.ColumnDefinitions>

      <!-- List -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="12,10" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" Margin="6,2">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2Brush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="b" Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="{Binding PartyName}" Style="{StaticResource Muted}" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="999" Padding="8,3" VerticalAlignment="Center"
                        Background="{Binding Tone, Converter={StaticResource ToneBg}}" Margin="8,0">
                  <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                             Foreground="{Binding Tone, Converter={StaticResource ToneFg}}" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding TotalDisplay}" FontWeight="SemiBold"
                           VerticalAlignment="Center" MinWidth="110" TextAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Detail preview -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <!-- Empty state -->
          <TextBlock Text="{Binding [sales.preview], Source={StaticResource Loc}}" Style="{StaticResource Muted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding Detail, Converter={StaticResource NullVisInv}}" />

          <!-- Document -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Detail}"
                        Visibility="{Binding Converter={StaticResource NullVis}}">
            <StackPanel Margin="16">
              <StackPanel Orientation="Horizontal">
                <Border CornerRadius="999" Padding="8,3" Background="{Binding Tone, Converter={StaticResource ToneBg}}">
                  <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                             Foreground="{Binding Tone, Converter={StaticResource ToneFg}}" />
                </Border>
                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock Text="{Binding PartyName}" FontWeight="SemiBold" FontSize="15" Margin="0,14,0,0" />
              <TextBlock Text="{Binding BranchName}" Style="{StaticResource Muted}" />
              <TextBlock Text="{Binding DateDisplay}" Style="{StaticResource Muted}" Margin="0,2,0,0" />

              <Border Background="{DynamicResource LineBrush}" Height="1" Margin="0,14" />

              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding QuantityDisplay}" Style="{StaticResource Muted}"
                                 Margin="8,0" />
                      <TextBlock Grid.Column="2" Text="{Binding LineTotalDisplay}" FontWeight="SemiBold"
                                 MinWidth="90" TextAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Background="{DynamicResource LineBrush}" Height="1" Margin="0,14" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding [sales.subtotal], Source={StaticResource Loc}}" Style="{StaticResource Muted}" />
                  <TextBlock Text="{Binding [sales.discount], Source={StaticResource Loc}}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding [sales.tax], Source={StaticResource Loc}}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding [common.total], Source={StaticResource Loc}}" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding [sales.paid], Source={StaticResource Loc}}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding [sales.outstanding], Source={StaticResource Loc}}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding SubtotalDisplay}" TextAlignment="Right" />
                  <TextBlock Text="{Binding DiscountDisplay}" TextAlignment="Right" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding TaxDisplay}" TextAlignment="Right" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding TotalDisplay}" FontWeight="SemiBold" TextAlignment="Right" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding PaidDisplay}" TextAlignment="Right" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding OutstandingDisplay}" TextAlignment="Right" Margin="0,4,0,0"
                             Foreground="{DynamicResource DestructiveBrush}" />
                </StackPanel>
              </Grid>

              <Border Background="{DynamicResource LineBrush}" Height="1" Margin="0,14" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding [sales.issuedBy], Source={StaticResource Loc}}" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding StaffName}" FontWeight="SemiBold" Margin="6,0,0,0" FontSize="12" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
