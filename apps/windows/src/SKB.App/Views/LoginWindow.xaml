<Window x:Class="SKB.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SKB — Sign in"
        Height="640" Width="960"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection, Source={StaticResource Loc}}"
        Background="{DynamicResource CanvasBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="1.1*" />
    </Grid.ColumnDefinitions>

    <!-- Brand panel -->
    <Border Grid.Column="0" Background="{DynamicResource BrandBrush}" Padding="40">
      <Grid>
        <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
          <Border Width="46" Height="46" CornerRadius="12" Background="#33FFFFFF">
            <TextBlock Text="SKB" Foreground="White" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding [app.name], Source={StaticResource Loc}}"
                       Foreground="White" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding [app.tagline], Source={StaticResource Loc}}"
                       Foreground="#CCFFFFFF" FontSize="13" />
          </StackPanel>
        </StackPanel>

        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                   HorizontalAlignment="Left"
                   Text="{Binding [auth.welcome], Source={StaticResource Loc}}"
                   Foreground="White" FontSize="24" FontWeight="SemiBold" />
      </Grid>
    </Border>

    <!-- Form panel -->
    <Grid Grid.Column="1" Margin="0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
        <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleLanguageCommand}"
                Content="{Binding [pref.language], Source={StaticResource Loc}}" />
        <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleThemeCommand}"
                Content="{Binding [pref.theme], Source={StaticResource Loc}}" Margin="6,0,0,0" />
      </StackPanel>

      <StackPanel Width="320" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding [auth.signIn], Source={StaticResource Loc}}" Style="{StaticResource H1}" />
        <TextBlock Text="{Binding [auth.welcome], Source={StaticResource Loc}}"
                   Style="{StaticResource Muted}" Margin="0,4,0,20" />

        <TextBlock Text="{Binding [auth.email], Source={StaticResource Loc}}" Margin="0,0,0,6" />
        <TextBox Style="{StaticResource Input}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{Binding [auth.password], Source={StaticResource Loc}}" Margin="0,14,0,6" />
        <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPassword}" />

        <CheckBox x:Name="RememberCheck" Margin="0,14,0,0" IsChecked="{Binding Remember}"
                  Content="{Binding [auth.rememberDevice], Source={StaticResource Loc}}"
                  Foreground="{DynamicResource MutedBrush}" />

        <Border Margin="0,14,0,0" Padding="10,8" CornerRadius="8"
                Background="{DynamicResource DestructiveSoftBrush}"
                Visibility="{Binding Error, Converter={StaticResource NullVis}}">
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DestructiveBrush}" TextWrapping="Wrap" />
        </Border>

        <Button x:Name="SignInButton" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                Click="SignInButton_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                Content="{Binding [auth.signIn], Source={StaticResource Loc}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
          <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                   Fill="{Binding Connection.State, Converter={StaticResource ToneFg}}" />
          <TextBlock Margin="6,0,0,0" Style="{StaticResource Muted}"
                     Text="{Binding Connection.State}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
