<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light theme brushes. Dark.xaml defines the same keys. -->
  <SolidColorBrush x:Key="CanvasBrush" Color="#F5F6F8" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Surface2Brush" Color="#F0F2F5" />
  <SolidColorBrush x:Key="LineBrush" Color="#E2E5EA" />
  <SolidColorBrush x:Key="FgBrush" Color="#10151C" />
  <SolidColorBrush x:Key="MutedBrush" Color="#55607A" />
  <SolidColorBrush x:Key="FaintBrush" Color="#8A93A6" />

  <SolidColorBrush x:Key="BrandBrush" Color="#4F46E5" />
  <SolidColorBrush x:Key="BrandFgBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BrandSoftBrush" Color="#ECEAFE" />

  <SolidColorBrush x:Key="PositiveBrush" Color="#0F9D58" />
  <SolidColorBrush x:Key="PositiveSoftBrush" Color="#E4F5EC" />
  <SolidColorBrush x:Key="WarningBrush" Color="#B7791F" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#FBF1DE" />
  <SolidColorBrush x:Key="DestructiveBrush" Color="#D1382C" />
  <SolidColorBrush x:Key="DestructiveSoftBrush" Color="#FBE6E4" />
  <SolidColorBrush x:Key="InfoBrush" Color="#2563EB" />
  <SolidColorBrush x:Key="InfoSoftBrush" Color="#E4EDFD" />
</ResourceDictionary>
