// SKB database schema (PostgreSQL).
// Money is stored as integers in MINOR UNITS (e.g. piastres/cents) — never floats.
// This schema runs identically on the company server today and on a cloud DB later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  SALES
  INVENTORY
  VIEWER
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  FACTORY
}

enum DocumentType {
  QUOTATION
  SALES_INVOICE
  SALES_RETURN
  PURCHASE_INVOICE
  PURCHASE_RETURN
  COLLECTION_RECEIPT
  PAYMENT_VOUCHER
  EXPENSE
}

enum DocumentStatus {
  DRAFT
  PENDING
  CONFIRMED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  RETURNED
}

model Branch {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  location String?
  isActive Boolean @default(true)

  staff     Staff[]
  documents SalesDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id           String  @id @default(uuid())
  fullName     String
  email        String  @unique
  passwordHash String
  role         Role    @default(VIEWER)
  phone        String?
  isActive     Boolean @default(true)

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  sessions  Session[]
  documents SalesDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
}

/// A server-side, revocable refresh session. The refresh token is never stored in
/// plaintext: `tokenHash` verifies it, and `encryptedToken` holds the AES-256-GCM
/// ciphertext used to support session inspection/rotation. This backs the future
/// owner/CEO "who is connected" view and lets any session be killed remotely.
model Session {
  id             String    @id @default(uuid())
  staff          Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId        String
  tokenHash      String    @unique
  encryptedToken Bytes
  userAgent      String?
  ip             String?
  deviceLabel    String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([staffId])
  @@index([expiresAt])
}

/// Immutable record of every meaningful action. Foundation for the owner activity view.
model AuditEntry {
  id         String   @id @default(uuid())
  actorId    String
  actorName  String
  action     String
  resource   String
  resourceId String?
  branchId   String?
  ip         String?
  userAgent  String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([resource])
  @@index([createdAt])
}

model Party {
  id        String      @id @default(uuid())
  name      String
  types     PartyType[]
  phone     String?
  email     String?
  taxNumber String?
  /// Net balance in minor units: >0 they owe us (receivable), <0 we owe them (payable).
  balance   Int         @default(0)
  currency  String      @default("EGP")
  isActive  Boolean     @default(true)

  documents SalesDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Category {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

model Product {
  id           String  @id @default(uuid())
  sku          String  @unique
  name         String
  unit         String  @default("pc")
  costPrice    Int     @default(0)
  salePrice    Int     @default(0)
  currency     String  @default("EGP")
  stockOnHand  Int     @default(0)
  reorderLevel Int     @default(0)
  barcode      String?
  isActive     Boolean @default(true)

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  lines DocumentLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model SalesDocument {
  id            String         @id @default(uuid())
  number        String         @unique
  type          DocumentType
  status        DocumentStatus @default(CONFIRMED)
  issueDate     DateTime       @default(now())
  dueDate       DateTime?
  subtotal      Int            @default(0)
  discountTotal Int            @default(0)
  taxTotal      Int            @default(0)
  grandTotal    Int            @default(0)
  paidAmount    Int            @default(0)
  currency      String         @default("EGP")
  notes         String?

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String
  party    Party  @relation(fields: [partyId], references: [id])
  partyId  String
  staff    Staff  @relation(fields: [staffId], references: [id])
  staffId  String

  lines DocumentLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([partyId])
  @@index([staffId])
  @@index([type, status])
  @@index([issueDate])
}

model DocumentLine {
  id          String @id @default(uuid())
  productName String
  quantity    Int    @default(1)
  unitPrice   Int    @default(0)
  discount    Int    @default(0)
  lineTotal   Int    @default(0)

  document   SalesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  product    Product       @relation(fields: [productId], references: [id])
  productId  String

  @@index([documentId])
  @@index([productId])
}
