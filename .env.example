# ============================================================================
# SKB environment. Copy to `.env` and fill real values. NEVER commit `.env`.
# ============================================================================

# --- Database (PostgreSQL on the company server) ---------------------------
POSTGRES_USER=skb
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=skb
POSTGRES_PORT=5432
# The API server reads this. On the company server, host/port point at the DB.
DATABASE_URL=postgresql://skb:change_me_strong_password@localhost:5432/skb?schema=public

# --- API server ------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
# Comma-separated origins allowed to call the API (the web app URLs).
# In production put the exact company URLs (https). No wildcards.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Session / token cryptography ------------------------------------------
# Generate strong random values, e.g.:  openssl rand -base64 48
# ACCESS_TOKEN: short-lived JWT signing secret.
JWT_ACCESS_SECRET=generate_a_long_random_secret
JWT_ACCESS_TTL=900            # seconds (15 min)
# REFRESH tokens are random, stored HASHED in the DB, and can be revoked.
JWT_REFRESH_TTL=2592000       # seconds (30 days)
# 32-byte (64 hex chars) key used to encrypt session/refresh material at rest.
SESSION_ENCRYPTION_KEY=generate_64_hex_chars_32_bytes
# Set true when served over HTTPS (production). Keeps cookies Secure.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Web app ---------------------------------------------------------------
# The address of the company API server, as reached by clients.
# On the LAN this is the server PC's IP, e.g. http://192.168.1.10:3000
VITE_API_URL=http://localhost:3000

# --- Bootstrap owner account (created by the seed on first run) ------------
SEED_OWNER_EMAIL=owner@skb.local
SEED_OWNER_PASSWORD=ChangeMe!Owner123
