# ============================================================================
# SKB — root env. Used by docker-compose (PostgreSQL) and the web app.
# The C# API server is configured separately in apps/api (appsettings / env vars).
# Copy to `.env` and fill real values. NEVER commit `.env`.
# ============================================================================

# --- PostgreSQL (started by `pnpm db:up`) ----------------------------------
POSTGRES_USER=skb
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=skb
POSTGRES_PORT=5432

# --- Web app ---------------------------------------------------------------
# Address of the C# API server as reached by clients.
# Dev default matches the API's launch profile. On the LAN use the server's
# static IP / internal DNS, e.g. https://skb.company.local:5443
VITE_API_URL=http://localhost:5080

# --- Whole-app on your own server (docker compose --profile full) ----------
# Only needed when running the app + database together on a company server.
APP_PORT=8080
COOKIE_SECURE=false
# Generate strong values:  openssl rand -base64 48   and   openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret
SESSION_ENCRYPTION_KEY=generate_64_hex_chars_32_bytes
SEED_OWNER_EMAIL=owner@skb.local
SEED_OWNER_PASSWORD=ChangeMe!Owner123
# A fresh database starts empty (owner, one branch, its warehouse and cash box). true = demo data.
SEED_DEMO=false
# Automatic daily backups (see COMPANY-SERVER.md). Set a passphrase to encrypt them — and keep it
# somewhere safe: without it a backup can't be opened.
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP=14
TZ=Africa/Cairo

# Offline assistant (AI on this server, no internet after the first download).
# Lighter chat model for a weaker machine (e.g. Raspberry Pi 5): qwen2.5:1.5b-instruct (Apache 2.0).
# Avoid qwen2.5:3b / qwen2.5vl:3b: their licence doesn't allow commercial use.
ASSISTANT_ENABLED=true
ASSISTANT_MODEL=qwen2.5:7b-instruct
ASSISTANT_VISION_MODEL=qwen2.5vl:7b
# Spoken questions: the Whisper model (tiny, base, small, medium). small reads Arabic well on a
# Raspberry Pi 5; base is lighter and quicker, medium better and slower.
SPEECH_MODEL=small
